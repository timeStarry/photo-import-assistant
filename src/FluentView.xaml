<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" FontSize="14" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource CanvasBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="192"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource NavigationBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="12,24,12,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="32"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="16,0,0,0"><Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left"><Viewbox Margin="8"><Canvas Width="24" Height="24"><Path Data="M 3,6 L 7,6 L 9,3 L 15,3 L 17,6 L 21,6 L 21,20 L 3,20 Z" Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="1.5" StrokeLineJoin="Round"/><Ellipse Canvas.Left="8" Canvas.Top="9" Width="8" Height="8" Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="1.5"/></Canvas></Viewbox></Border><TextBlock Text="相机导入助手" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0"/></StackPanel>
        <StackPanel Grid.Row="2">
          <Button x:Name="ImportNav" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Padding="16,12" Margin="0,0,0,4"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,2,12,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock Text="导入" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
          <Button x:Name="CardsNav" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Padding="16,12" Margin="0,0,0,4"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE88E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,2,12,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock Text="存储卡" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
          <Button x:Name="LocationsNav" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Padding="16,12" Margin="0,0,0,4"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,2,12,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock Text="导入位置" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
          <Button x:Name="ActivityNav" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Padding="16,12"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,2,12,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock Text="活动记录" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="16,0,4,20"><Ellipse x:Name="ListenerDot" Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0"/><TextBlock x:Name="ListenerLabel" Text="监听中" FontSize="12" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
        <Button x:Name="SettingsNav" Grid.Row="5" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Padding="16,12"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,2,12,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock Text="设置" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="28,26,28,24">
      <Grid x:Name="ImportPage">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid><TextBlock Text="导入" FontSize="28" FontWeight="SemiBold"/><Button x:Name="ScanButton" Content="刷新" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="刷新存储卡"/></Grid>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0"><StackPanel>
          <ComboBox x:Name="CardPicker" HorizontalAlignment="Stretch" DisplayMemberPath="Label" SelectedValuePath="Root" Margin="0,0,0,16" Visibility="Collapsed" AutomationProperties.Name="选择存储卡"/>
          <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,16"><StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border Width="48" Height="58" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top"><Viewbox Margin="12"><Canvas Width="28" Height="40"><Path Data="M 4,1 L 20,1 L 26,7 L 26,38 L 2,38 L 2,3 Z M 7,1 L 7,12 M 12,1 L 12,12 M 17,1 L 17,12 M 7,23 L 20,23 M 7,29 L 17,29" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"/></Canvas></Viewbox></Border>
              <StackPanel Grid.Column="1" Margin="0,0,16,0"><TextBlock x:Name="CardTitle" Text="等待存储卡" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="CardSubtitle" Text="插入 SD 卡" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/></StackPanel>
              <Border x:Name="CardBadge" Background="{DynamicResource WarningSoftBrush}" CornerRadius="4" Padding="8,4" Grid.Column="2" VerticalAlignment="Top"><TextBlock x:Name="CardBadgeText" Text="未登记" FontSize="12"/></Border>
            </Grid>
            <Grid x:Name="MediaSummary" Margin="0,24,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock x:Name="PhotoLabel" Text="待导入照片" Style="{StaticResource Caption}"/><TextBlock x:Name="PhotoCount" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock x:Name="VideoLabel" Text="待导入视频" Style="{StaticResource Caption}"/><TextBlock x:Name="VideoCount" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="合计" Style="{StaticResource Caption}"/><TextBlock x:Name="MediaSize" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
            </Grid>
            <TextBlock x:Name="ComparisonSummary" Style="{StaticResource Caption}" Margin="0,12,0,0" Visibility="Collapsed"/>
            <StackPanel x:Name="StorageSummary" Margin="0,20,0,0"><ProgressBar x:Name="StorageUsage" Height="4" Maximum="100" BorderThickness="0" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource StrokeBrush}"/><TextBlock x:Name="StorageText" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel>
            <Border x:Name="GuidanceBox" Background="{DynamicResource WarningSoftBrush}" CornerRadius="4" Padding="12,10" Margin="0,18,0,0" Visibility="Collapsed"><TextBlock x:Name="CardGuidance" Style="{StaticResource Body}"/></Border>
            <Grid x:Name="CardActionRow" Margin="0,22,0,0"><StackPanel Orientation="Horizontal"><Button x:Name="PrimaryAction" Content="登记存储卡" Style="{StaticResource PrimaryButton}" MinWidth="136"/><Button x:Name="PreferencesButton" Content="卡片设置" Style="{StaticResource QuietButton}" Margin="8,0,0,0"/></StackPanel></Grid>
            <Expander x:Name="CardDetails" Header="详细信息" Foreground="{DynamicResource MutedBrush}" Margin="0,16,0,0" FontSize="12"><StackPanel><TextBox x:Name="IdentityText" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontSize="12" TextWrapping="Wrap" Padding="0,10,0,0" AutomationProperties.Name="存储卡标识与卷信息"/><Button x:Name="RegisterButton" Content="重新关联" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="-10,4,0,0"/></StackPanel></Expander>
          </StackPanel></Border>
          <Border x:Name="ProgressCard" Style="{StaticResource Card}" Padding="24,20" Margin="0,0,0,16" Visibility="Collapsed"><StackPanel><Grid><TextBlock x:Name="ProgressTitle" Text="正在导入" FontSize="16" FontWeight="SemiBold"/><Button x:Name="CancelButton" Content="取消" HorizontalAlignment="Right" Style="{StaticResource QuietButton}" Padding="12,0" MinHeight="24"/></Grid><TextBlock x:Name="ProgressDescription" Style="{StaticResource Caption}" Margin="0,12,0,12"/><ProgressBar x:Name="TransferProgress" Height="5" Maximum="1000" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource StrokeBrush}" BorderThickness="0"/><TextBlock x:Name="ActiveDestinationText" Style="{StaticResource Caption}" Margin="0,10,0,0"/></StackPanel></Border>
          <Border x:Name="OutcomeCard" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16" Visibility="Collapsed"><TextBlock x:Name="OutcomeText" Style="{StaticResource Body}"/></Border>
          <Border Style="{StaticResource Card}" Padding="24,20"><StackPanel><Grid Margin="0,0,0,16"><TextBlock Text="保存到" FontSize="16" FontWeight="SemiBold"/><Button x:Name="ManageLocationsButton" Content="更改" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" MinHeight="24" Padding="8,0"/></Grid><TextBlock x:Name="DestinationName" Text="选择导入位置" FontWeight="SemiBold"/><TextBlock x:Name="DestinationType" Style="{StaticResource Caption}" Margin="0,6,0,0"/><TextBlock x:Name="DestinationPath" Style="{StaticResource Caption}" Margin="0,4,0,0"/><TextBlock x:Name="FallbackSummary" Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel></Border>
        </StackPanel></ScrollViewer>
      </Grid>
      <Grid x:Name="CardsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="存储卡" FontSize="28" FontWeight="SemiBold"/><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock x:Name="CardsEmpty" Text="尚无存储卡" Style="{StaticResource Caption}" Margin="0,16"/><StackPanel x:Name="CardsList"/></StackPanel></ScrollViewer></Grid>
      <Grid x:Name="LocationsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="导入位置" FontSize="28" FontWeight="SemiBold"/><Button x:Name="AddLocationButton" Content="添加位置" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"/></Grid><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
        <TextBlock x:Name="LocationsEmpty" Text="添加文件夹、网络共享、WebDAV 或 S3 位置" Style="{StaticResource Caption}" Margin="0,0,0,16"/>
        <TextBlock x:Name="NextBatchNote" Text="位置更改将在下次导入生效" Style="{StaticResource Caption}" Margin="0,0,0,16" Visibility="Collapsed"/>
        <StackPanel x:Name="LocationsList"/>
        <Border Style="{StaticResource Card}" Padding="20" Margin="0,8,0,0"><StackPanel><TextBlock Text="当前位置不可用时" FontWeight="SemiBold"/><ComboBox x:Name="FailurePicker" HorizontalAlignment="Stretch" Margin="0,12,0,0" AutomationProperties.Name="位置不可用时的处理"><ComboBoxItem Content="按顺序尝试下一位置"/><ComboBoxItem Content="停止导入"/></ComboBox></StackPanel></Border>
      </StackPanel></ScrollViewer></Grid>
      <Grid x:Name="ActivityPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="活动记录" FontSize="28" FontWeight="SemiBold"/><Button x:Name="OpenLogsButton" Content="完整日志" HorizontalAlignment="Right"/></Grid><Border Grid.Row="2" Style="{StaticResource Card}" Padding="20"><Grid><TextBlock x:Name="NoActivities" Text="暂无记录" Style="{StaticResource Caption}" VerticalAlignment="Center" HorizontalAlignment="Center"/><ListBox x:Name="ActivityList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><Grid Margin="0,8,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse Width="6" Height="6" Fill="{Binding Dot}" VerticalAlignment="Top" Margin="0,7,0,0"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Message}" Style="{StaticResource Body}"/><TextBlock Text="{Binding Time}" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border></Grid>
      <Grid x:Name="SettingsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="设置" FontSize="28" FontWeight="SemiBold"/><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,24,0"><TextBlock Text="传输" FontWeight="SemiBold"/><TextBlock x:Name="ConcurrencySummary" Style="{StaticResource Caption}" Margin="0,6,0,0" AutomationProperties.AutomationId="Settings.Concurrency"/><TextBlock x:Name="TransferSettingsSummary" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel><Button x:Name="TransferSettingsButton" Content="传输设置(_T)" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="编辑传输设置" AutomationProperties.AutomationId="Settings.EditTransfer"/></Grid></Border>
        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,24,0"><TextBlock Text="文件范围" FontWeight="SemiBold"/><TextBlock x:Name="ExclusionsSummary" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel><Button x:Name="ExclusionsButton" Content="排除后缀" Grid.Column="1" VerticalAlignment="Center"/></Grid></Border>
        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12"><Grid><TextBlock Text="外观" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox x:Name="ThemePicker" Width="156" HorizontalAlignment="Right" AutomationProperties.Name="界面主题"><ComboBoxItem Content="跟随系统"/><ComboBoxItem Content="浅色"/><ComboBoxItem Content="深色"/></ComboBox></Grid></Border>
        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,24,0"><TextBlock Text="登录后启动" FontWeight="SemiBold"/><TextBlock x:Name="StartupStatus" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel><CheckBox x:Name="StartupCheck" Content="开启" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="登录后自动启动"/></Grid></Border>
        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,24,0"><TextBlock Text="发现未登记的卡" FontWeight="SemiBold"/><TextBlock Text="打开窗口，便于登记" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel><CheckBox x:Name="NewCardsCheck" Content="提示" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="发现未登记卡时打开窗口"/></Grid></Border>
        <Border Style="{StaticResource Card}" Padding="20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,24,0"><TextBlock Text="自动提示" FontWeight="SemiBold"/><TextBlock x:Name="PauseDescription" Text="运行中" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel><Button x:Name="PauseButton" Grid.Column="1" Content="暂停" VerticalAlignment="Center"/></Grid></Border>
      </StackPanel></ScrollViewer></Grid>
    </Grid>
  </Grid>
</UserControl>
